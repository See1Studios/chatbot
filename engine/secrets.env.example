# Copy to $CHATBOT_DATA/secrets.env and chmod 600. Do not commit that copy.
# Placeholders only. Empty or commented means unset. No real keys.

# providers.json api_key_env for the omniroute HTTP adapter
CHATBOT_OMNIROUTE_API_KEY=

# providers.json api_key_env for OpenRouter
OPENROUTER_API_KEY=

# Optional host-wide A/B, not an API key. 1|true|on|yes enables private refusal mitigation.
# CHATBOT_PRIVATE_REFUSAL_MITIGATION=
