#!/bin/sh
# ENGINE_DECIDES_A5: only a transaction that moves main is checked; every other ref update passes at shell speed.
# MAIN_WATCH_v1 (#825): once main has moved, the whole suite checks it in the background (engine/tools/main_watch.py).
case "$1" in prepared|committed) ;; *) exit 0 ;; esac
input=$(cat)
case "$input" in *" refs/heads/main"*) ;; *) exit 0 ;; esac
top="$(git rev-parse --show-toplevel)"
if [ "$1" = committed ]; then
  [ -n "${CHATBOT_TEST_RUNNER:-}" ] && exit 0   # a test's own repos never start a suite
  main_tree="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"   # the main tree's copy, also from a worktree
  watch="$main_tree/engine/tools/main_watch.py"
  state="$HOME/.cache/chatbot-main-watch"
  # in the background: the git command that moved main does not wait for the suite
  [ -f "$watch" ] && mkdir -p "$state" && { nohup python3 "$watch" run >>"$state/watch.log" 2>&1 </dev/null & }
  exit 0
fi
printf '%s\n' "$input" | exec python3 "$top/.githooks/check_staged.py" reference-transaction "$1"
