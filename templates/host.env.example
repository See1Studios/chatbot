# Per-install settings for chatbot-ctl.sh (align/F). Copy to $CHATBOT_DATA/host.env and uncomment what this machine
# needs. Not secrets -- API keys go in secrets.env. Unset means the portable default.

# The NAS host plugin (nas_mcp_host.py: this machine's services, wiki, Hermes). Off by default.
# NAS_MCP_HOST_PLUGIN=1

# An external static web root this install publishes into (persona images, a /chat shortcut).
# Default: $CHATBOT_DATA/web
# CHATBOT_WEB_ROOT=/path/to/web

# Ports (defaults 3011 chat, 3012 MCP).
# CHATBOT_PORT=3011
# NAS_MCP_PORT=3012
